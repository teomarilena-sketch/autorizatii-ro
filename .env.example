# Copiază acest fișier în `.env.local` și completează valorile reale.

# URL public al site-ului (folosit pentru metadate, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://autorizatii.ro

# --- Integrare formular de contact (opțional) ---
# Resend (email transacțional)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=contact@autorizatii.ro

# Slack / Telegram webhook pentru notificări interne
LEAD_WEBHOOK_URL=
